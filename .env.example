# Required: Gemini API key (server-side only — never exposed to the browser)
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Optional: override the model used for analysis and Q&A
# (default: gemini-3.5-flash-lite — 500 requests/day on the free tier.
# Flash models like gemini-3.5-flash / gemini-3.8-flash allow only ~20
# requests/day each; quotas are per-model, reset at midnight Pacific)
# GEMINI_MODEL=gemini-3.5-flash-lite
