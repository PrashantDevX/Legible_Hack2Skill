# Required: Gemini API key (server-side only — never exposed to the browser)
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Optional: override the model used for analysis and Q&A
# (default: gemini-3.5-flash — works on the free tier; quotas are per-model
# and reset at midnight Pacific; e.g. gemini-3.8-flash has a lower free cap)
# GEMINI_MODEL=gemini-3.5-flash
